{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react",
    "strict": true, "noEmit": true, "skipLibCheck": true, "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noUnusedLocals": true, "noUnusedParameters": false, "isolatedModules": true, "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
